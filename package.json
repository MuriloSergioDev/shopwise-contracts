{
  "name": "@shopwise/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shopwise event schemas and HTTP API contracts, with generated TypeScript types.",
  "packageManager": "pnpm@12.15.0",
  "exports": {
    ".": "./ts/index.ts"
  },
  "files": [
    "ts",
    "schemas",
    "openapi",
    "asyncapi.yaml"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/validate.mjs && pnpm generate && git diff --exit-code -- php ts && tsc --noEmit",
    "roundtrip": "docker run --rm -v .:/app -w /app shopwise-php:base php scripts/roundtrip.php",
    "compat": "node scripts/compat.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "lefthook": "^2.2.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
