{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.dev/schemas/events/orders/order-placed.v1.json",
  "title": "OrderPlaced",
  "description": "Reply to orders.place-order: the order exists. Notifications mails a confirmation. Keyed by orderId.",
  "type": "object",
  "required": [
    "orderId",
    "number",
    "checkoutId",
    "customerId",
    "email",
    "lines",
    "currency",
    "subtotal",
    "discount",
    "total",
    "couponCode",
    "shippingAddress",
    "placedAt"
  ],
  "properties": {
    "orderId": { "type": "string", "maxLength": 26 },
    "number": { "type": "string", "pattern": "^SW-[0-9]{6,}$", "description": "Human-readable order number." },
    "checkoutId": { "type": "string", "maxLength": 26 },
    "customerId": { "type": "string", "maxLength": 26 },
    "email": { "type": "string", "format": "email", "maxLength": 255 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["sku", "productName", "variantName", "quantity", "unitAmount", "lineAmount"],
        "properties": {
          "sku": { "type": "string", "maxLength": 64 },
          "productName": {
            "type": ["string", "null"],
            "maxLength": 200,
            "description": "Display name at checkout time; null if the cart had none."
          },
          "variantName": { "type": "string", "maxLength": 200 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 99 },
          "unitAmount": { "type": "integer", "minimum": 0, "description": "Minor units (cents)." },
          "lineAmount": { "type": "integer", "minimum": 0, "description": "Minor units (cents)." }
        },
        "additionalProperties": false
      }
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 code." },
    "subtotal": { "type": "integer", "minimum": 0, "description": "Minor units (cents)." },
    "discount": { "type": "integer", "minimum": 0, "description": "Minor units; never more than the subtotal." },
    "total": { "type": "integer", "minimum": 0, "description": "Minor units (cents)." },
    "couponCode": { "type": ["string", "null"], "maxLength": 32 },
    "shippingAddress": {
      "type": "object",
      "required": ["name", "line1", "line2", "city", "region", "postalCode", "country"],
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "line1": { "type": "string", "maxLength": 200 },
        "line2": { "type": ["string", "null"], "maxLength": 200 },
        "city": { "type": "string", "maxLength": 100 },
        "region": { "type": ["string", "null"], "maxLength": 100 },
        "postalCode": { "type": "string", "maxLength": 20 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2." }
      },
      "additionalProperties": false,
      "description": "Where the order ships to."
    },
    "placedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
