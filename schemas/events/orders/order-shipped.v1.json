{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.dev/schemas/events/orders/order-shipped.v1.json",
  "title": "OrderShipped",
  "description": "An admin marked the order shipped. Notifications mails the tracking details. Keyed by orderId.",
  "type": "object",
  "required": ["orderId", "number", "customerId", "email", "carrier", "trackingNumber", "shippedAt"],
  "properties": {
    "orderId": { "type": "string", "maxLength": 26 },
    "number": { "type": "string", "pattern": "^SW-[0-9]{6,}$" },
    "customerId": { "type": "string", "maxLength": 26 },
    "email": { "type": "string", "format": "email", "maxLength": 255 },
    "carrier": { "type": "string", "maxLength": 50 },
    "trackingNumber": { "type": "string", "maxLength": 100 },
    "shippedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
