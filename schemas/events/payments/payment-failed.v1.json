{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.dev/schemas/events/payments/payment-failed.v1.json",
  "title": "PaymentFailed",
  "description": "Reply to payments.request-payment or payments.refund-payment: no money was taken (declined, canceled or timed out). Keyed by paymentId.",
  "type": "object",
  "required": [
    "paymentId",
    "checkoutId",
    "customerId",
    "amount",
    "currency",
    "reason",
    "message",
    "stripePaymentIntentId",
    "failedAt"
  ],
  "properties": {
    "paymentId": {
      "type": ["string", "null"],
      "maxLength": 26,
      "description": "Null when no payment was ever created for the checkout."
    },
    "checkoutId": { "type": "string", "maxLength": 26 },
    "customerId": { "type": "string", "maxLength": 26 },
    "amount": { "type": "integer", "minimum": 0, "description": "Minor units (cents)." },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 code." },
    "reason": {
      "type": "string",
      "enum": ["card_declined", "insufficient_funds", "authentication_required", "canceled", "timeout", "processing_error"]
    },
    "message": { "type": ["string", "null"], "maxLength": 500, "description": "Stripe's message, safe to show the customer." },
    "stripePaymentIntentId": { "type": ["string", "null"], "maxLength": 255 },
    "failedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
