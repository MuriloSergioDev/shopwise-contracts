{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.dev/schemas/events/payments/refunded.v1.json",
  "title": "Refunded",
  "description": "A succeeded payment was refunded in full; the reply to payments.refund-payment. Notifications mails the customer. Keyed by paymentId.",
  "type": "object",
  "required": ["paymentId", "checkoutId", "customerId", "amount", "currency", "reason", "stripeRefundId", "refundedAt"],
  "properties": {
    "paymentId": { "type": "string", "maxLength": 26 },
    "checkoutId": { "type": "string", "maxLength": 26 },
    "customerId": { "type": "string", "maxLength": 26 },
    "amount": { "type": "integer", "minimum": 0, "description": "Minor units (cents)." },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 code." },
    "reason": { "type": "string", "enum": ["reservation_expired", "order_rejected", "timeout"] },
    "stripeRefundId": { "type": "string", "maxLength": 255 },
    "refundedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
