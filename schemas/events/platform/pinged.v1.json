{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.dev/schemas/events/platform/pinged.v1.json",
  "title": "Pinged",
  "description": "A ping was accepted by the template service. Exists only to prove the HTTP → outbox → Kafka → consumer path.",
  "type": "object",
  "required": ["pingId", "message", "requestedAt"],
  "properties": {
    "pingId": { "type": "string" },
    "message": { "type": "string", "maxLength": 200 },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
