{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.dev/schemas/events/catalog/product-published.v1.json",
  "title": "ProductPublished",
  "description": "A product became visible in the storefront. Carries its variants so consumers learn every sellable SKU at once.",
  "type": "object",
  "required": ["productId", "slug", "name", "categoryId", "variants", "publishedAt"],
  "properties": {
    "productId": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "maxLength": 200 },
    "categoryId": { "type": "string" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variantId", "sku", "name", "options"],
        "properties": {
          "variantId": { "type": "string" },
          "sku": { "type": "string", "maxLength": 64 },
          "name": { "type": "string", "maxLength": 200 },
          "options": {
            "type": "array",
            "description": "Variant options sorted by name, e.g. color=Black and size=M. A list, not a map, so an empty set stays a JSON array through the outbox.",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": { "name": { "type": "string", "maxLength": 50 }, "value": { "type": "string", "maxLength": 50 } },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "publishedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
