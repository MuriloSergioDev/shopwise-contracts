{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.dev/schemas/events/cart/cart-checked-out.v1.json",
  "title": "CartCheckedOut",
  "description": "A completed checkout closed the cart; the customer gets a new one on next access. Lines are the checkout's snapshot. Keyed by cartId.",
  "type": "object",
  "required": ["cartId", "customerId", "checkoutId", "orderId", "lines", "checkedOutAt"],
  "properties": {
    "cartId": { "type": "string", "maxLength": 26 },
    "customerId": { "type": "string", "maxLength": 26 },
    "checkoutId": { "type": "string", "maxLength": 26 },
    "orderId": { "type": "string", "maxLength": 26 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["sku", "quantity"],
        "properties": { "sku": { "type": "string", "maxLength": 64 }, "quantity": { "type": "integer", "minimum": 1, "maximum": 99 } },
        "additionalProperties": false
      }
    },
    "checkedOutAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
