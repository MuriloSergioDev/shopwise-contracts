{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.dev/schemas/events/inventory/reservation-failed.v1.json",
  "title": "ReservationFailed",
  "description": "Reply to inventory.reserve-stock: nothing was held because at least one line could not be. Keyed by checkoutId.",
  "type": "object",
  "required": ["checkoutId", "reason", "lines", "failedAt"],
  "properties": {
    "checkoutId": { "type": "string", "maxLength": 26 },
    "reason": { "type": "string", "enum": ["insufficient_stock", "unknown_sku"] },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "description": "Only the lines that could not be reserved.",
      "items": {
        "type": "object",
        "required": ["sku", "requested", "available"],
        "properties": {
          "sku": { "type": "string", "maxLength": 64 },
          "requested": { "type": "integer", "minimum": 1, "maximum": 99 },
          "available": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "failedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
