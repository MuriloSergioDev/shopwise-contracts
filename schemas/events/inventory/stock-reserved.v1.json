{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.dev/schemas/events/inventory/stock-reserved.v1.json",
  "title": "StockReserved",
  "description": "Reply to inventory.reserve-stock: every line is held until expiresAt. Keyed by checkoutId.",
  "type": "object",
  "required": ["reservationId", "checkoutId", "lines", "expiresAt", "reservedAt"],
  "properties": {
    "reservationId": { "type": "string", "maxLength": 26 },
    "checkoutId": { "type": "string", "maxLength": 26 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["sku", "quantity"],
        "properties": { "sku": { "type": "string", "maxLength": 64 }, "quantity": { "type": "integer", "minimum": 1, "maximum": 99 } },
        "additionalProperties": false
      }
    },
    "expiresAt": { "type": "string", "format": "date-time" },
    "reservedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
