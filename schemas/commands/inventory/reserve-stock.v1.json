{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.dev/schemas/commands/inventory/reserve-stock.v1.json",
  "title": "ReserveStock",
  "description": "Command from checkout: hold stock for a checkout's lines, all or nothing. One reservation per checkoutId; a repeated command re-publishes the outcome. Replies: inventory.stock-reserved or inventory.reservation-failed. Keyed by checkoutId.",
  "type": "object",
  "required": ["checkoutId", "lines", "requestedAt"],
  "properties": {
    "checkoutId": { "type": "string", "maxLength": 26 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["sku", "quantity"],
        "properties": { "sku": { "type": "string", "maxLength": 64 }, "quantity": { "type": "integer", "minimum": 1, "maximum": 99 } },
        "additionalProperties": false
      }
    },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
